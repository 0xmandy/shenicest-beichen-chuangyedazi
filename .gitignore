# 命题给的原始材料（政策 xlsx / 金融工具 xlsx / 命题 PPT），不入库
data/*.xlsx
data/*.pptx
data/*.pdf

# 从政府网站抓下来的政策原文语料，18MB。不入库，跑三个抓取脚本能重建，
# 重建命令见 README「补贴条款怎么重建」
data/policy-raw/

# 部署与自查产物
dist/
qa-out/
.wrangler/

# 结构化脚本的输出，内容已经内联进 html，不重复入库
tools/policy-db.js
tools/finance-db.js
tools/subsidy-db.js

# 方案文档的派生产物：mermaid 渲染出的 PNG 与拆出来的六份 docx。
# 改内容改那份 md，再重跑 出图png / 出docx分册 两个脚本，不入库。
# 注意 tools/mermaid.min.js 是入库的，它是脚本要读的画图库本体，不是产物。
tools/figs/
tools/docx/

.DS_Store
__pycache__/
*.pyc
